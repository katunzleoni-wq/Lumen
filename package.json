{
  "name": "lumen-biblioteca-espirita",
  "version": "1.0.0",
  "private": true,
  "description": "Lumen — Biblioteca Digital Espírita Internacional. Leitura multilíngue de obras espíritas em EPUB e PDF.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "npm run search:index && next dev",
    "build": "npm run search:index && npm run verify:editions && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "search:index": "node scripts/build-search-index.mjs",
    "sources:fetch": "node scripts/fetch-sources.mjs",
    "assets:generate": "node scripts/build-real-editions.mjs",
    "assets:verify": "node scripts/validate-editions.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "verify:editions": "node scripts/validate-editions.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "epubjs": "0.3.93",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-intl": "3.26.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-pdf": "9.2.1",
    "react-reader": "2.0.15",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "epub-gen-memory": "^1.1.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "lint-staged": "^15.2.11",
    "pagefind": "^1.5.2",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,yml,yaml}": [
      "prettier --write"
    ]
  }
}
